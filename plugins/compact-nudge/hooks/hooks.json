{
  "description": "Suggests /compact or /clear when the context crosses a size threshold, and before a large context is sent with a cold prompt cache.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
